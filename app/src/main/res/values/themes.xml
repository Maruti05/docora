<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      The XML theme only controls the window (splash, window background, system bars).
      All in-app colour comes from the Compose theme in ui/designsystem/DocoraTheme.kt.
    -->
    <style name="Theme.Docora" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/docora_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
    </style>

    <!-- Cold-start splash: shows the logo while the Compose tree is first composed. -->
    <style name="Theme.Docora.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/docora_window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="windowSplashScreenAnimationDuration">200</item>
        <item name="postSplashScreenTheme">@style/Theme.Docora</item>
    </style>
</resources>
