<?xml version="1.0" encoding="utf-8"?>
<!--
  Deliberately built from RemoteViews only (no extra widget library): a widget must stay
  cheap to inflate and must never trigger heavy work in the launcher process.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/app_name"
        android:textColor="@color/widget_on_surface"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_recent_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="middle"
        android:maxLines="1"
        android:text="@string/collection_recent"
        android:textColor="@color/widget_on_surface_muted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_recent_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/empty_library_title"
        android:textColor="@color/widget_on_surface_muted"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_action_scan"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/widget_action_background"
            android:gravity="center"
            android:text="@string/nav_scan"
            android:textColor="@color/widget_on_surface"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_action_search"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/widget_action_background"
            android:gravity="center"
            android:text="@string/nav_search"
            android:textColor="@color/widget_on_surface"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_action_recent"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/widget_action_background"
            android:gravity="center"
            android:text="@string/collection_recent"
            android:textColor="@color/widget_on_surface"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
